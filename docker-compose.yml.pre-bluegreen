services:

  db:
    image: postgres:16
    container_name: banking-db
    environment:
      POSTGRES_DB: bankingdb
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    volumes:
      - ./db/schema.sql:/docker-entrypoint-initdb.d/schema.sql

  backend1:
    build: ./backend
    depends_on:
      - db

  backend2:
    build: ./backend
    depends_on:
      - db

  frontend:
    build: ./frontend
    depends_on:
      - backend1
      - backend2

  nginx:
    image: nginx:alpine
    container_name: banking-nginx
    depends_on:
      - frontend
      - backend1
      - backend2
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./nginx/errors:/usr/share/nginx/errors:ro
      - ./nginx/ssl:/etc/nginx/ssl:ro
